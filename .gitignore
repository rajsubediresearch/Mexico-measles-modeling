# ── Raw data (DGE line lists — do not push) ───────────────────────────────────
Base_Lunes_*.xlsx
*ANONIMIZADA*.xlsx
data/raw/

# Cleaned line-list copies of the raw data (same records as the Excel files)
outputs/02_cleaned_data_*/

# Excel lock/temp files
~$*

# ── R / RStudio / Positron ────────────────────────────────────────────────────
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.positron/
*.Rproj.user

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
*.swp

# ── Forecasting ───────────────────────────────────────────────────────────────
# scratch copy of the toolbox used by run_forecasts.m
forecasting/work/
forecasting/_to_delete/
# large toolbox workspaces (.mat); CSV outputs are kept
forecasting/runs/**/*.mat
# toolbox .fig files (large: every bootstrap curve is stored); PNGs are kept
forecasting/runs/**/toolbox_figures/*.fig

# ── Manuscript drafts (kept locally, not in git) ─────────────────────────────
/*.docx
~$*.docx
